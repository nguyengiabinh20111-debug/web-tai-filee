<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tải File Delta</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f5f7; margin: 0; padding: 20px; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); width: 100%; max-width: 400px; text-align: center; }
        h2 { font-size: 20px; color: #333; margin-bottom: 15px; }
        .select-box { width: 100%; padding: 12px; margin-bottom: 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 16px; background: #fff; }
        .btn { background: #2563eb; color: white; padding: 12px; border: none; border-radius: 8px; width: 100%; font-size: 16px; font-weight: bold; cursor: pointer; text-decoration: none; display: inline-block; }
    </style>
</head>
<body>

<div class="card">
    <h2>Chọn Phiên Bản Tải Về</h2>
    <select id="versionSelect" class="select-box" onchange="document.getElementById('downloadBtn').href = this.value;">
        <option value="#" selected>-- Chọn phiên bản Roblox --</option>
        <option value="https://drive.google.com/uc?export=download&id=16cFv0A1SlXkztIvPEyOHuGGEVGPvI_9m">Delta - Roblox Quốc Tế</option>
        <option value="https://drive.google.com/uc?export=download&id=1yhQR2953pHu_5U08WKR1Z4H8ZMHx9FoQ">Delta - Roblox VNG</option>
    </select>
    <a id="downloadBtn" href="#" class="btn" onclick="if(this.getAttribute('href')==='#'){alert('Vui lòng chọn phiên bản trước khi tải!'); return false;}">Download</a>
</div>

</body>
</html>
